# Copy to web/.env.local. Only VITE_-prefixed values reach the browser bundle, and no
# secret may ever be listed here: the Unlink admin API key and the Circle kit key stay
# on the backend.

# Select exactly "demo" or "live". When omitted, an API base URL selects live;
# otherwise the app starts in demo mode. A failed live health check never falls back.
VITE_BACKEND_MODE=demo

# Base URL of the Clean Privacy backend.
# In development `/api` is proxied to BACKEND_ORIGIN (see vite.config.ts).
VITE_API_BASE_URL=

# Where the demo video is hosted. Defaults to /media/clean-privacy-arc-demo.mp4, which
# `npm run extract-assets -- "../Clean Privacy for Arc.html" --with-video` writes locally.
VITE_DEMO_VIDEO_URL=

# Development only: origin of the local backend the /api proxy forwards to.
BACKEND_ORIGIN=http://127.0.0.1:8787
