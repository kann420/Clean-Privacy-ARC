# Copy this file to .env.local (the file the scripts load) and keep the
# populated file local. Real environment variables override file entries.
# Use credentials created only for Arc Testnet.

# Server-side Unlink administration credential. Never expose it to browser code.
UNLINK_API_KEY_ARC_TESTNET=


# Server-side Circle App Kit / Swap Kit key for swap quotes and calldata.
# Never expose it to browser code.
CIRCLE_APP_KIT_KEY=

# Dedicated Arc Testnet script wallet key (0x-prefixed 32-byte hex).
# Use a faucet-funded throwaway wallet only; never a mainnet key.
OWNER_PRIVATE_KEY=

# Optional: override the Arc RPC endpoint used by the backend relay only.
# Provider URLs usually embed a token, so treat this as a secret: keep it in
# .env.local, never in config/chains.json, and never behind a VITE_ prefix
# (VITE_ values are bundled into the browser).
ARC_RPC_URL=

# Optional: override the SOURCE-chain RPC endpoint used by scripts/bridge-to-arc.mjs
# when funding Arc over CCTP. Without it the script dials the endpoint Circle
# publishes for that chain. Same secrecy rules as ARC_RPC_URL: HTTPS only, and
# .env.local only.
BRIDGE_SOURCE_RPC_URL=
